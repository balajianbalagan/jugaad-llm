# ==============================================================================
# BROWSER OPENROUTER GATEWAY CONFIGURATION
# Uses your authenticated free-tier web accounts via Chromium (No API keys needed)
# ==============================================================================

# Gateway master key (Set empty or custom token for your hackathon apps)
LITELLM_MASTER_KEY=sk-hackathon-token

# Operator dashboard sign-in password (defaults to LITELLM_MASTER_KEY if unset)
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_HOURS=24

# Server host & port
LITELLM_PORT=4000
LITELLM_HOST=0.0.0.0
DATABASE_URL=sqlite:///data/gateway.db

# Rate limits & timeouts
GLOBAL_RATE_LIMIT=1000
USER_RATE_LIMIT=100
REQUEST_TIMEOUT=120
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# BROWSER AUTOMATION SETTINGS
# ------------------------------------------------------------------------------
BROWSER_ENABLED=true
# Run browser in headless mode (true) or visible window (false)
# Headless uses Chromium new stealth headless mode with mocked user agent & screen depth
BROWSER_HEADLESS=false
CHROME_USER_DATA_DIR=data/chrome_profile

# Optional: Connect to your existing running Chrome via remote debugging
# (e.g. chrome.exe --remote-debugging-port=9222)
BROWSER_CDP_URL=

# ------------------------------------------------------------------------------
# HACKATHON TEMPORARY NGROK TUNNEL
# Get your free token at https://dashboard.ngrok.com/get-started/your-authtoken
# ------------------------------------------------------------------------------
NGROK_AUTHTOKEN=

# ------------------------------------------------------------------------------
# OPTIONAL ZERO-COST API FALLBACKS (Zero credit card required)
# ------------------------------------------------------------------------------
ENABLE_API_KEYS=false
CONFIG_PATH=config/litellm_config.yaml

# Google AI Studio Gemini (100% Free, no credit card needed at aistudio.google.com)
GEMINI_API_KEY=

# Groq (Free tier available at console.groq.com)
GROQ_API_KEY=

# OpenRouter Free Models key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
